/* DESIGN TOKENS */
:root {
    --bg-main: #F4F7F6;
    --bg-surface: #FFFFFF;
    --primary: #042B22;     /* Deep dark green */
    --primary-light: #124A3D;
    --accent: #B2FF59;      /* Tech Lime */
    --text-dark: #1E293B;
    --text-muted: #64748B;
    --border: #E2E8F0;
    
    --green: #10B981;
    --yellow: #F59E0B;
    --red: #EF4444;

    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
    --radius-lg: 24px;
    --radius-md: 16px;
}

/* RESET & BASE */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: var(--bg-main);
    color: var(--text-dark);
    display: flex;
    height: 100vh;
    overflow: hidden;
}

h1, h2, h3, h4 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; }

/* SIDEBAR */
.sidebar {
    width: 280px;
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    z-index: 10;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 700;
    font-family: 'Space Grotesk';
    color: var(--primary);
    margin-bottom: 40px;
}
.logo-box {
    background: var(--primary);
    color: var(--accent);
    width: 40px; height: 40px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
}

.nav-links { display: flex; flex-direction: column; gap: 8px; }
.nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px; border-radius: 12px;
    text-decoration: none; color: var(--text-muted);
    font-weight: 600; font-size: 0.95rem;
    transition: all 0.2s ease;
}
.nav-item:hover { background: var(--bg-main); color: var(--primary); }
.nav-item.active { background: var(--primary); color: var(--bg-surface); }
.nav-item.active i { color: var(--accent); }

/* MAIN AREA */
.app-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

.top-nav {
    height: 80px; background: var(--bg-surface);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; border-bottom: 1px solid var(--border);
}
.top-nav h1 { font-size: 1.5rem; color: var(--primary); }
.top-actions { display: flex; align-items: center; gap: 20px; }
.avatar img { width: 44px; height: 44px; border-radius: 50%; background: var(--bg-main); }

.btn-primary {
    background: var(--primary); color: var(--bg-surface);
    border: none; padding: 12px 24px; border-radius: 12px;
    font-family: 'Space Grotesk'; font-size: 0.95rem; font-weight: 600;
    display: flex; align-items: center; gap: 8px; cursor: pointer;
    transition: 0.2s;
}
.btn-primary:hover { background: var(--primary-light); transform: translateY(-2px); }
.w-full { width: 100%; justify-content: center; }

/* CONTENT WRAPPER & ANIMATIONS */
.content-wrapper { padding: 40px; overflow-y: auto; flex: 1; }
.page { display: none; animation: fadeUp 0.4s ease forwards; }
.page.active { display: block; }
@keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

/* 1. BENTO DASHBOARD */
.bento-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
}
.bento-card {
    background: var(--bg-surface); padding: 24px; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); transition: 0.3s;
}
.bento-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); }
.hero-card { grid-column: span 2; background: var(--primary); color: var(--bg-surface); }
.hero-card h3 { color: var(--accent); margin-bottom: 10px; }
.big-metric { font-size: 4rem; font-family: 'Space Grotesk'; font-weight: 700; line-height: 1; margin-bottom: 10px; }
.big-metric span { font-size: 2rem; color: var(--accent); }
.card-icon { color: var(--accent); background: var(--primary); padding: 12px; border-radius: 12px; width: 48px; height: 48px; margin-bottom: 16px; }
.bento-card h4 { font-size: 2rem; margin-top: 4px; }
.label { color: var(--text-muted); font-size: 0.9rem; font-weight: 600; }
.col-span-2 { grid-column: span 2; }
.activity-list { margin-top: 20px; display: flex; flex-direction: column; gap: 16px; }
.activity-item { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; }
.activity-item span { margin-left: auto; color: var(--text-muted); font-size: 0.8rem; }
.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot.green { background: var(--green); }
.dot.yellow { background: var(--yellow); }
.dot.red { background: var(--red); }

/* 2. AI SCANNER */
.scanner-wrap { max-width: 600px; margin: 0 auto; background: var(--bg-surface); padding: 40px; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
.upload-area { border: 2px dashed var(--border); padding: 60px 20px; text-align: center; border-radius: var(--radius-md); cursor: pointer; transition: 0.3s; background: var(--bg-main); }
.upload-area:hover { border-color: var(--primary); background: #ebf0ef; }
.upload-icon { width: 64px; height: 64px; background: var(--primary); color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.hidden { display: none !important; }

.scan-box { position: relative; width: 150px; height: 150px; margin: 0 auto 20px; border: 2px solid var(--border); border-radius: 20px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.scan-box i { width: 60px; height: 60px; color: var(--text-muted); }
.laser { position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--accent); box-shadow: 0 0 15px var(--accent); animation: scanLine 1.5s infinite linear; }
@keyframes scanLine { 0% { top: 0; } 100% { top: 100%; } }
.scanning-loader { text-align: center; }

.result-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
.score-ring { width: 80px; height: 80px; border-radius: 50%; border: 6px solid var(--primary); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--primary); }
.score-ring h3 { font-size: 1.8rem; line-height: 1; }
.score-ring span { font-size: 0.7rem; font-weight: bold; }
.condition-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
.chip { padding: 12px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 8px; }
.chip.green { background: rgba(16, 185, 129, 0.1); color: var(--primary); }
.chip.yellow { background: rgba(245, 158, 11, 0.1); color: #B45309; }
.chip.red { background: rgba(239, 68, 68, 0.1); color: #B91C1C; }
.disclaimer { display: flex; gap: 12px; background: var(--bg-main); padding: 16px; border-radius: 10px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px; }

/* 3. REPAIRABILITY GATE */
.gate-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.gate-card { background: var(--bg-surface); padding: 32px; border-radius: var(--radius-lg); border-top: 6px solid transparent; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.gate-card.green-path { border-color: var(--green); }
.gate-card.yellow-path { border-color: var(--yellow); }
.gate-card.red-path { border-color: var(--red); }
.gate-head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
.traffic-light { width: 24px; height: 24px; border-radius: 50%; }
.tl-green { background: var(--green); box-shadow: 0 0 15px var(--green); }
.tl-yellow { background: var(--yellow); box-shadow: 0 0 15px var(--yellow); }
.tl-red { background: var(--red); box-shadow: 0 0 15px var(--red); }
.gate-card p { color: var(--text-muted); margin-bottom: 32px; flex: 1; }
.flow-steps { background: var(--bg-main); padding: 16px; border-radius: 10px; font-weight: 700; font-size: 0.85rem; color: var(--primary); text-align: center; font-family: 'Space Grotesk'; }

/* 4. PASSPORT */
.passport-ui { max-width: 800px; margin: 0 auto; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
.passport-header { background: var(--primary); color: var(--bg-surface); padding: 32px; display: flex; justify-content: space-between; align-items: center; }
.tag { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); }
.pt-status { padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; }
.pt-status.yellow { background: var(--yellow); color: #fff; }
.passport-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: 32px; }
.p-info p { margin-bottom: 12px; color: var(--text-muted); }
.p-info strong { color: var(--text-dark); }
.p-components h4 { margin-bottom: 16px; }
.triage-list { display: flex; flex-direction: column; gap: 8px; }
.triage-list span { display: flex; align-items: center; gap: 8px; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.9rem; }
.t-good { background: rgba(16, 185, 129, 0.1); color: var(--primary); }
.t-bad { background: rgba(239, 68, 68, 0.1); color: #B91C1C; }
.lifecycle-timeline { display: flex; justify-content: space-between; padding: 0 32px 32px; position: relative; }
.lifecycle-timeline::before { content: ''; position: absolute; top: 10px; left: 50px; right: 50px; height: 2px; background: var(--border); z-index: 1; }
.timeline-node { position: relative; z-index: 2; padding-top: 24px; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-align: center; }
.timeline-node::before { content: ''; position: absolute; top: 4px; left: 50%; transform: translateX(-50%); width: 14px; height: 14px; background: var(--border); border-radius: 50%; border: 4px solid var(--bg-surface); }
.timeline-node.done::before { background: var(--primary); }
.timeline-node.done { color: var(--primary); }
.timeline-node.active::before { background: var(--accent); box-shadow: 0 0 0 3px rgba(178, 255, 89, 0.3); }
.timeline-node.active { color: var(--primary); }

/* 5. HEALTH */
.health-ui { max-width: 700px; margin: 0 auto; background: var(--bg-surface); padding: 40px; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
.overall-health { text-align: center; margin-bottom: 40px; }
.health-big-num { font-size: 4rem; font-family: 'Space Grotesk'; font-weight: 700; color: var(--primary); }
.health-bars { display: flex; flex-direction: column; gap: 20px; }
.h-label { display: flex; justify-content: space-between; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem; }
.track { width: 100%; height: 12px; background: var(--bg-main); border-radius: 6px; overflow: hidden; }
.fill { height: 100%; border-radius: 6px; }
.fill.green { background: var(--green); }
.fill.yellow { background: var(--yellow); }
.fill.red { background: var(--red); }

/* 6. REPAIR MATCH */
.match-ui { max-width: 650px; margin: 0 auto; background: var(--bg-surface); padding: 40px; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
.match-problem { background: rgba(245, 158, 11, 0.1); padding: 20px; border-radius: 12px; margin-bottom: 24px; }
.match-problem h3 { color: #B45309; display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.match-solution { background: var(--bg-main); padding: 20px; border-radius: 12px; margin-bottom: 24px; display: flex; flex-direction: column; gap: 12px; }
.match-eco { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
.eco-card { border: 1px solid var(--border); padding: 20px; border-radius: 12px; text-align: center; }
.eco-card p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; }
.eco-card h4 { font-size: 1.5rem; color: var(--primary); }
.text-green { color: var(--green) !important; }
.match-benefit { display: flex; gap: 12px; padding: 16px; background: var(--primary); color: var(--bg-surface); border-radius: 12px; margin-bottom: 24px; }

/* 7. PART BANK */
.bank-filters { display: flex; gap: 12px; margin-bottom: 24px; align-items: center; flex-wrap: wrap; }
.filter-btn { padding: 10px 20px; border: 1px solid var(--border); border-radius: 20px; background: var(--bg-surface); cursor: pointer; font-family: 'Plus Jakarta Sans'; font-weight: 600; transition: 0.2s; }
.filter-btn.active, .filter-btn:hover { background: var(--primary); color: var(--bg-surface); border-color: var(--primary); }
.search-box { margin-left: auto; display: flex; align-items: center; background: var(--bg-surface); border: 1px solid var(--border); padding: 8px 16px; border-radius: 20px; gap: 8px; }
.search-box input { border: none; outline: none; font-family: 'Plus Jakarta Sans'; width: 200px; }
.part-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
.p-card { background: var(--bg-surface); padding: 24px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.p-card h3 { color: var(--primary); margin-bottom: 12px; }
.p-detail { font-size: 0.9rem; margin-bottom: 6px; display: flex; justify-content: space-between; }
.p-detail span:first-child { color: var(--text-muted); }
.p-cat { display: inline-block; padding: 4px 10px; background: var(--bg-main); color: var(--primary); font-weight: 700; font-size: 0.75rem; border-radius: 6px; margin-top: 12px; text-transform: uppercase; }

/* 8. CIRCULAR ROUTE */
.route-diagram { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; padding: 40px 0; }
.node { padding: 16px 24px; background: var(--bg-surface); border-radius: 12px; box-shadow: var(--shadow-sm); font-family: 'Space Grotesk'; font-weight: 700; text-align: center; width: 260px; z-index: 2; position: relative; border: 2px solid transparent; }
.node.source { background: var(--text-dark); color: white; }
.node.process { border-color: var(--border); }
.node.gate { background: var(--primary); color: var(--accent); }
.line { background: var(--border); z-index: 1; }
.line.vertical { width: 2px; height: 30px; }
.branches { display: flex; justify-content: center; gap: 40px; position: relative; margin-top: -2px; width: 100%; }
.branch { display: flex; flex-direction: column; align-items: center; position: relative; flex: 1; }
.line-connector { position: absolute; top: -30px; height: 2px; background: var(--border); width: 100%; }
.line-connector.left { left: 50%; width: 50%; }
.line-connector.right { right: 50%; width: 50%; }
.node.green-path { border-color: var(--green); }
.node.yellow-path { border-color: var(--yellow); }
.node.red-path { border-color: var(--red); }
.node.target { background: var(--primary-light); color: white; border: none; }
.node.bg-red { background: var(--text-dark); }
.route-caption { margin-top: 40px; font-weight: 600; color: var(--text-muted); text-align: center; }

/* 9. VALUE LOOP */
.value-loop-ui { max-width: 700px; margin: 0 auto; }
.value-loop-ui h2 { margin-bottom: 40px; color: var(--primary); }
.pyramid-container { display: flex; flex-direction: column; gap: 12px; align-items: center; }
.pyramid-layer { display: flex; justify-content: space-between; align-items: center; padding: 24px 32px; border-radius: 12px; color: white; box-shadow: var(--shadow-sm); }
.layer-1 { width: 100%; background: var(--primary); }
.layer-2 { width: 85%; background: var(--primary-light); }
.layer-3 { width: 70%; background: #2B7A63; }
.layer-4 { width: 55%; background: #4B9A84; }
.l-text h3 { font-size: 1.2rem; }
.l-text span { font-size: 0.85rem; opacity: 0.8; }
.l-val { font-size: 1.5rem; font-family: 'Space Grotesk'; font-weight: 700; }

/* 10. IMPACT DASHBOARD */
.impact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.impact-card { background: var(--primary); color: white; padding: 40px; border-radius: var(--radius-lg); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: 200px; }
.bg-icon { position: absolute; right: -20px; bottom: -20px; width: 150px; height: 150px; opacity: 0.05; }
.i-val { font-size: 3.5rem; font-family: 'Space Grotesk'; font-weight: 700; color: var(--accent); margin-bottom: 8px; z-index: 2; line-height: 1; }
.unit { font-size: 1.5rem; }
.i-label { font-size: 1.1rem; z-index: 2; opacity: 0.9; }
.impact-card.full { grid-column: span 2; background: var(--bg-surface); color: var(--primary); text-align: center; padding: 60px 40px; border: 1px solid var(--border); }
.impact-card.full h2 { margin-bottom: 32px; max-width: 700px; margin-inline: auto; }
.circularity-bar { max-width: 500px; margin: 0 auto; }
.c-label { font-weight: 700; margin-bottom: 12px; text-align: left; }
.track .theme { background: var(--primary); color: var(--accent); text-align: right; padding-right: 12px; font-weight: bold; line-height: 24px; }
.impact-card.full .track { height: 24px; border-radius: 12px; background: var(--bg-main); }
