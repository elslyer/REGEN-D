:root {
    --primary: #103A36; 
    --secondary: #1F8A70; 
    --accent: #A6E22E; 
    --background: #F2F7F5; 
    --surface: #FFFFFF; 
    --text-main: #18302F; 
    --text-muted: #78908D; 
    --status-green: #2ecc71;
    --status-yellow: #f1c40f;
    --status-red: #e74c3c;
    --shadow: 0 8px 30px rgba(16, 58, 54, 0.08);
    --hover-shadow: 0 15px 40px rgba(31, 138, 112, 0.2);
    --border-radius: 16px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'DM Sans', sans-serif;
    background: linear-gradient(135deg, var(--background) 0%, #E2ECE9 100%);
    color: var(--text-main);
    display: flex;
    height: 100vh;
    overflow: hidden;
}

h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; font-weight: 600; }

/* SIDEBAR - Added Gradient & Hover FX */
.sidebar {
    width: 260px;
    background: linear-gradient(180deg, var(--primary) 0%, #0a2623 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    transition: 0.3s;
    box-shadow: 4px 0 20px rgba(0,0,0,0.1);
    z-index: 20;
}

.logo { padding: 24px; display: flex; align-items: center; gap: 12px; font-size: 1.3rem; color: var(--accent); }
.nav-menu { padding: 0 12px; gap: 4px; display: flex; flex-direction: column;}
.nav-item {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
    text-decoration: none; color: #c0d1cf; border-radius: 12px;
    transition: all 0.3s ease; position: relative; overflow: hidden;
}
.nav-item:hover { background: rgba(255,255,255,0.05); color: #fff; transform: translateX(5px); }
.nav-item.active { background: var(--secondary); color: #fff; box-shadow: 0 4px 15px rgba(31, 138, 112, 0.4); }

/* MAIN CONTENT */
.main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.topbar { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); height: 75px; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; border-bottom: 1px solid rgba(0,0,0,0.05); z-index: 10; }

.btn { display: flex; align-items: center; gap: 8px; padding: 12px 24px; border: none; border-radius: 10px; font-family: 'Outfit'; font-weight: 600; cursor: pointer; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
.btn-primary { background: var(--secondary); color: #fff; box-shadow: 0 4px 15px rgba(31,138,112,0.3); }
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(31,138,112,0.5); }
.btn-secondary { background: transparent; color: var(--secondary); border: 2px solid var(--secondary); }
.btn-secondary:hover { background: var(--secondary); color: #fff; }

/* INTERACTIVITY & CARDS */
.interactive-hover { transition: all 0.3s ease; cursor: pointer; }
.interactive-hover:hover { transform: translateY(-5px); }

.stat-card, .gate-card, .passport-card, .health-container, .repair-match-card, .part-card, .impact-card {
    background: var(--surface);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0,0,0,0.02);
}
.stat-card:hover, .gate-card:hover, .part-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--hover-shadow);
    border-color: rgba(31, 138, 112, 0.3);
}

/* ANIMATIONS */
.page { display: none; }
.page.active { display: block; }

.stagger-item { opacity: 0; transform: translateY(20px); animation: slideUp 0.6s ease forwards; }
@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }

/* AI SCANNER ENHANCEMENTS */
.upload-zone { border: 2px dashed var(--secondary); border-radius: var(--border-radius); padding: 60px 20px; background: rgba(31,138,112,0.05); display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: 0.3s; }
.upload-zone:hover { background: rgba(31,138,112,0.1); border-color: var(--primary); }

.scanner-frame {
    position: relative; width: 220px; height: 160px; margin: 0 auto 20px;
    border: 2px solid var(--secondary); border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 20px rgba(31,138,112,0.2); overflow: hidden;
}
.scan-line {
    position: absolute; top: 0; left: 0; width: 100%; height: 3px;
    background: var(--accent); box-shadow: 0 0 15px 3px var(--accent);
    animation: scan 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
@keyframes scan { 0% { top: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
.pulse-icon { animation: iconPulse 2s infinite; color: var(--secondary); }
@keyframes iconPulse { 0%, 100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.1); opacity: 1; } }

/* DYNAMIC PROGRESS BARS */
.progress-bar { width: 100%; height: 10px; background: #e0e0e0; border-radius: 5px; overflow: hidden; }
.progress { height: 100%; border-radius: 5px; width: 0; transition: width 1.5s cubic-bezier(0.25, 0.8, 0.25, 1); }
.progress.good { background: var(--status-green); }
.progress.warn { background: var(--status-yellow); }

/* GRID LAYOUTS */
.grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; padding: 20px; }
.stat-card { padding: 24px; display: flex; align-items: center; gap: 16px; }
.stat-card.highlight { background: var(--secondary); color: #fff; }
.stat-card.highlight-alt { background: var(--primary); color: #fff; }
.stat-icon { width: 56px; height: 56px; border-radius: 14px; background: rgba(31,138,112,0.1); color: var(--secondary); display: flex; align-items: center; justify-content: center; }
.stat-card.highlight .stat-icon, .stat-card.highlight-alt .stat-icon { background: rgba(255,255,255,0.2); color: #fff; }

/* MODAL UI */
.modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(16, 58, 54, 0.6); backdrop-filter: blur(5px); z-index: 100; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: 0.3s; }
.modal-overlay:not(.hidden) { opacity: 1; visibility: visible; }
.modal-content { background: var(--surface); width: 400px; padding: 24px; border-radius: 20px; transform: scale(0.9); transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 20px 50px rgba(0,0,0,0.2); }
.modal-overlay:not(.hidden) .modal-content { transform: scale(1); }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #eee; padding-bottom: 12px; }
.close-btn { cursor: pointer; color: var(--text-muted); transition: 0.2s; }
.close-btn:hover { color: var(--status-red); transform: rotate(90deg); }
.spin-icon { animation: spin 1s linear infinite; color: var(--secondary); width: 40px; height: 40px; }
@keyframes spin { 100% { transform: rotate(360deg); } }

/* PART BANK (Grid) */
.part-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; padding: 10px; }
.part-card { padding: 24px; cursor: pointer; }
.part-tag { background: rgba(166, 226, 46, 0.2); padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; color: var(--primary); font-weight: bold; margin-top: 12px; display: inline-block; }

.hidden { display: none !important; }
